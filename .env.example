# ---- Seguranca (gere com: python3 gerenciar.py gerar-chaves)
FLASK_SECRET_KEY=
# Criptografa os tokens dos clientes. GUARDE uma copia fora do servidor: perder = todos reconectam.
CHAVE_MESTRA=

# ---- Sua marca
NOME_PRODUTO=Agendador de Reels
# So numeros, com 55 + DDD (aparece nos botoes de suporte/renovar)
SUPORTE_WHATSAPP=55
SUPORTE_EMAIL=
# Texto do preco no site
PRECO_TEXTO=R$ 49/mês
# Aparece nos termos de uso e na politica de privacidade
EMPRESA_RAZAO=
# Dias de teste gratis no cadastro
TESTE_DIAS=7

# ---- Operacao
# 0 = modo teste (nada vai ao ar). Trocar pra 1 depois do primeiro teste na VPS.
PUBLICAR_DE_VERDADE=0
# 1 quando estiver com HTTPS
COOKIE_SEGURO=1
FUSO=America/Sao_Paulo
# Espaco de videos por cliente (MB)
QUOTA_MB=3000
# Videos publicados sao apagados do disco depois de N dias
APAGAR_ARQUIVO_APOS_DIAS=7
# Post atrasado mais que isso (servidor caiu / cliente vencido) nao sai sozinho
ATRASO_MAX_H=12
